# HydraStore Distributed Object Storage Cluster Configuration

# Coordinator Configuration
COORDINATOR_HOST=0.0.0.0
COORDINATOR_PORT=8000
ENVIRONMENT=development

# Storage & Replication
DEFAULT_CHUNK_SIZE_BYTES=4194304  # 4 MB
REPLICATION_FACTOR=2              # 1 Primary + 1 Replica

# Database & Redis
DATABASE_URL=sqlite+aiosqlite:///hydrastore_metadata.db
REDIS_URL=redis://localhost:6379/0

# Storage Nodes
STORAGE_NODES=node-1:http://127.0.0.1:8001,node-2:http://127.0.0.1:8002,node-3:http://127.0.0.1:8003,node-4:http://127.0.0.1:8004
STORAGE_BASE_DIR=./data_nodes
